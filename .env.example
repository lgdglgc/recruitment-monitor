# Upstash Redis Credentials (https://console.upstash.com/)
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# 系统管理与定时任务调用密钥 (用于保护控制台接口与定时任务免遭未授权调用)
ADMIN_SECRET="your_custom_admin_secret"
CRON_SECRET="your_custom_admin_secret"

# ---- 消息推送渠道配置 (至少配置一项即可，支持多渠道并发推送) ----

# 1. Server酱 SendKey (https://sct.ftqq.com/)
SERVERCHAN_SENDKEY="SCTxxxxxxxxxxxxxxxxxxxx"

# 2. 企业微信群机器人 Webhook 地址 (支持直接推送到微信/企微工作群)
QYWX_WEBHOOK_URL="https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxxxx"

# 3. 飞书群自定义机器人 Webhook 地址
FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxx"

# 4. 钉钉群自定义机器人 Webhook 地址
DINGTALK_WEBHOOK_URL="https://oapi.dingtalk.com/robot/send?access_token=xxxxxx"

# 5. PushPlus (推送加) Token (http://www.pushplus.plus/)
PUSHPLUS_TOKEN="your_pushplus_token"

# ---- AI 智能招聘分析配置 (OpenAI 兼容接口) ----
AI_API_BASE_URL="https://api.openai.com/v1"
AI_API_KEY="your_ai_api_key"
AI_MODEL="gpt-4o-mini"
AI_ENABLE="true"
